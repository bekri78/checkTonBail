# Backend (FastAPI/Python) — variables d'environnement
# Copier ce fichier en .env pour le développement local

# Port du serveur (Railway l'injecte automatiquement en prod)
PORT=4000

# Clés API
OPENAI_API_KEY=sk-xxx
GOOGLE_VISION_API_KEY=xxx

# Stripe (sk_test_ pour dev, sk_live_ pour prod)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Origines autorisées pour CORS (URL du frontend, séparées par des virgules)
CORS_ORIGIN=http://localhost:3000

# URL du frontend pour le return_url Stripe
FRONTEND_URL=http://localhost:3000

# Clé admin pour /api/stats
ADMIN_API_KEY=change-me

# Limite de coût mensuelle (euros)
MAX_MONTHLY_COST=45

# Optionnel — dossier de données persistantes (monter un volume Railway dessus)
# DATA_DIR=/data

# Optionnel — tuning OCR
# PDF_ZOOM=2.0
# OCR_CONCURRENCY=8

# Backend (Node.js) - Variables d'environnement
# Copier ce fichier en .env pour le développement

# Port du serveur
PORT=4000

# Clés API
GROQ_API_KEY=gsk_xxx
OPENAI_API_KEY=sk-xxx

# Stripe (sk_test_ pour dev, sk_live_ pour prod)
STRIPE_SECRET_KEY=sk_test_xxx

# Origines autorisées pour CORS (URL du frontend)
CORS_ORIGIN=http://localhost:3000
